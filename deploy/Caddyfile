# Origin sits behind the Cloudflare Tunnel, so Caddy serves plain HTTP on :80
# (Cloudflare terminates TLS at the edge) and just adds baseline security
# headers + compression, then proxies everything — including the /api/live
# WebSocket, which Caddy upgrades automatically — to the Ridgeline daemon.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	# The observer-auth endpoints are for the JWT broker only, which reaches
	# ridgelined directly over the compose network and never through here.
	# Exposing them publicly would hand out a token-validity oracle and put the
	# ingest consumer's password behind an internet-facing check. handle blocks
	# are mutually exclusive, so this wins over the catch-all below.
	handle /api/mqtt-auth/* {
		respond 404
	}

	# The firmware build agent's endpoints, blocked for the same reason: the agent
	# reaches ridgelined over the compose network, and these hand out build jobs
	# and accept their results. Exposing them would let anyone drain the queue or
	# mark someone else's build complete.
	handle /api/firmware/agent/* {
		respond 404
	}

	handle {
		reverse_proxy ridgelined:8080
	}
}
